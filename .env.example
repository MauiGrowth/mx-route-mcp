# Reference for the environment variables mx-route-mcp reads. Nothing loads this
# file automatically: put the values in your MCP client's server config (see the
# README), or for a quick local check:
#   cp .env.example .env   # fill it in, never commit it
#   node --env-file=.env dist/index.js --check
# Create an API key at https://panel.mxroute.com/api-keys.php
MXROUTE_SERVER=eagle.mxlogin.com
MXROUTE_USERNAME=your_directadmin_username
MXROUTE_API_KEY=your_complete_api_key

# Optional
# MXROUTE_READ_ONLY=true
# MXROUTE_TOOLSETS=domains,mailboxes,forwarders
# MXROUTE_TIMEOUT_MS=30000
